{
	"name": "codejs",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "ISC",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx",
		"build": "tsc -p tsconfig.json",
