{
	"compilerOptions": {
		"target": "es2016",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": ".",
		"allowJs": true,
		"sourceMap": true
	},
	"include": ["learning/**/*.ts", "dsa/**/*.ts", "misc/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
